# Environment Variables for piolencboisdirect - Firewood E-Commerce Platform

# Database Connection. prisma/schema.prisma uses the `postgresql` provider, so
# this must be a PostgreSQL URL (Neon, Supabase, RDS, a local server, ...).
DATABASE_URL="postgresql://user:password@localhost:5432/piolencboisdirect?schema=public"

# Next.js App Secret for JWT Sessions.
# Required: without it the app refuses to issue or verify session tokens.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional Email Configuration (Provider options: "log" | "smtp" | "resend")
#
# Ces variables sont PRIORITAIRES sur les valeurs enregistrées en base : si
# EMAIL_PROVIDER est défini ici, il est utilisé partout, y compris si la page
# d'administration contient encore les exemples d'origine (smtp.example.com).
EMAIL_PROVIDER="log"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="contact@piolencboisdirect.fr"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="piolencboisdirect Bois <serviceclient@piolencboisdirect.fr>"
# Boîte réellement créée chez l'hébergeur : seule adresse du domaine qui
# accepte le courrier (contact@ et admin@ n'existent pas, elles reçoivent un
# 550 User doesn't exist).
ADMIN_NOTIFICATION_EMAIL="serviceclient@piolencboisdirect.fr"

# Envoi par Resend (EMAIL_PROVIDER="resend") : le domaine de RESEND_FROM doit
# être vérifié dans le compte Resend. La clé reste côté serveur uniquement.
RESEND_API_KEY="re_votre_cle_api"
RESEND_FROM="piolencboisdirect Bois <serviceclient@piolencboisdirect.fr>"

# Bank Wire Transfer Defaults (Editable directly in Admin Backoffice)
DEFAULT_BANK_NAME="BNP Paribas France"
DEFAULT_BANK_BENEFICIARY="PIOLENCBOISDIRECT DISTRIBUTION SAS"
DEFAULT_BANK_IBAN="FR7630004012340001234567890"
DEFAULT_BANK_BIC="BNPAFRPP"

# PostHog session replay (browser). Public project token, never a personal API key.
# Leave both empty to keep replay a no-op. Host: https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
