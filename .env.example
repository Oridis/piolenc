# Environment Variables for piolencboisdirect - Firewood E-Commerce Platform

# Database Connection (Default SQLite for standalone portability, or switch to PostgreSQL)
DATABASE_URL="file:./prisma/dev3.db"
# Example PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/piolencboisdirect?schema=public"

# Next.js App Secret for JWT Sessions
NEXTAUTH_SECRET="piolencboisdirect_production_secure_jwt_secret_2026_xyz"
NEXTAUTH_URL="http://localhost:3000"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional Email Configuration (Provider options: "log" | "smtp" | "resend")
EMAIL_PROVIDER="log"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="contact@piolencboisdirect.fr"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="piolencboisdirect Bois <contact@piolencboisdirect.fr>"
ADMIN_NOTIFICATION_EMAIL="admin@piolencboisdirect.fr"

# Bank Wire Transfer Defaults (Editable directly in Admin Backoffice)
DEFAULT_BANK_NAME="BNP Paribas France"
DEFAULT_BANK_BENEFICIARY="PIOLENCBOISDIRECT DISTRIBUTION SAS"
DEFAULT_BANK_IBAN="FR7630004012340001234567890"
DEFAULT_BANK_BIC="BNPAFRPP"
